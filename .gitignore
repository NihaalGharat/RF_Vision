# RF Vision .gitignore — research code, no raw data, no secrets
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
.pytest_cache/
.hypothesis/
logs/
*.log
# Research evidence lives OUTSIDE git (see research-data/README.md)
data/
# NOTE: ignore directory CONTENTS (not the dir itself) so the two
# negations below can re-include the tracked manifest + readme —
# git cannot re-include paths under an excluded parent directory.
research-data/*
!research-data/MANIFEST.md
!research-data/README.md
*.csv
!docs/reference/example_csi.csv
# Models/datasets produced locally
*.pkl
*.pt
*.pth
# Firmware build outputs (built in ESP-IDF, never committed)
firmware/**/build/
firmware/**/sdkconfig
firmware/**/*.bin
firmware/**/*.elf
# Unity generated (when the Unity phase starts)
unity/project/Library/
unity/project/Temp/
unity/project/Obj/
unity/project/Build/
# Build intermediates / native objects
*.o
*.a
*.map
dist/
# IDF component-manager output (rebuildable via idf.py build)
managed_components/
# Secrets — never commit
.env
.env.*
credentials*
*password*
*secret*
*token*
*.pem
*.key
# OS / editor
.DS_Store
Thumbs.db
.vscode/
.idea/
*~
